        {
          "id": "c7a0d93c-b67f-4fed-9854-50e6995f0b96",
          "name": "Postmark Get bounces",
          "request": {
            "name": "Postmark Get bounces",
            "description": {},
            "url": {
              "path": [
                "bounces"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) Number of bounces to return per request. Max 500.",
                    "type": "text/plain"
                  },
                  "key": "count",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) Number of bounces to skip.",
                    "type": "text/plain"
                  },
                  "key": "offset",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by type of bounce (This can only be one of HardBounce,Transient,Unsubscribe,Subscribe,AutoResponder,AddressChange,DnsError,SpamNotification,OpenRelayTest,Unknown,SoftBounce,VirusNotification,MailFrontier Matador.,BadEmailAddress,SpamComplaint,ManuallyDeactivated,Unconfirmed,Blocked,SMTPApiError,InboundError,DMARCPolicy,TemplateRenderingFailed)",
                    "type": "text/plain"
                  },
                  "key": "type",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by emails that were deactivated by Postmark due to the bounce. Set to true or false. If this isn't specified it will return both active and inactive.",
                    "type": "text/plain"
                  },
                  "key": "inactive",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by email address",
                    "type": "text/plain"
                  },
                  "key": "emailFilter",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by messageID",
                    "type": "text/plain"
                  },
                  "key": "messageID",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by tag",
                    "type": "text/plain"
                  },
                  "key": "tag",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter messages up to the date specified. e.g. `2014-02-01`",
                    "type": "text/plain"
                  },
                  "key": "todate",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter messages starting from the date specified. e.g. `2014-02-01`",
                    "type": "text/plain"
                  },
                  "key": "fromdate",
                  "value": ""
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The token associated with the Server on which this request will operate.",
                "key": "X-Postmark-Server-Token",
                "value": ""
              }
